                            <div><label class="text-xs font-bold text-gray-500 mb-1 block">العنوان</label><input id="archives-title" type="text" placeholder="مثال: المدخل الرئيسي"></div>
                            <div><label class="text-xs font-bold text-gray-500 mb-1 block">الوصف</label><textarea id="archives-desc" placeholder="وصف مختصر..." rows="2"></textarea></div>
                            <div><label class="text-xs font-bold text-gray-500 mb-1 block">رابط الصورة القديمة</label><input id="archives-old" type="url" placeholder="https://..."></div>
                            <div><label class="text-xs font-bold text-gray-500 mb-1 block">رابط الصورة الحديثة</label><input id="archives-new" type="url" placeholder="https://..."></div>
                            <div class="flex gap-2">
                                <button onclick="saveArchive()" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white py-3 rounded-xl font-bold text-sm transition-colors">💾 حفظ</button>
                                <button onclick="cancelArchiveEdit()" id="archives-cancel-btn" class="hidden bg-gray-200 hover:bg-gray-300 text-gray-600 py-3 px-4 rounded-xl font-bold text-sm transition-colors">إلغاء</button>
                            </div>
                        </div>
                    </div>
                    <div class="lg:col-span-2"><div id="archives-list" class="space-y-3"></div></div>
                </div>
            </div>

            <!-- ===== TOURISM SECTION ===== -->
            <div id="section-tourism" class="content-section hidden fade-in">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="lg:col-span-1 bg-white rounded-2xl p-6 shadow-md border border-gray-100 h-fit sticky top-24">
                        <h3 class="font-extrabold text-gray-800 mb-4 flex items-center gap-2">
                            <span class="iconify text-emerald-500" data-icon="lucide:plus-circle"></span>
                            <span id="tourism-form-title">إضافة معلم سياحي</span>
                        </h3>
                        <input type="hidden" id="tourism-edit-id" value="">
                        <div class="space-y-3">
                            <div><label class="text-xs font-bold text-gray-500 mb-1 block">الاسم</label><input id="tourism-name" type="text" placeholder="مثال: باي ويست"></div>
                            <div><label class="text-xs font-bold text-gray-500 mb-1 block">العنوان الفرعي</label><input id="tourism-subtitle" type="text" placeholder="Baie Ouest"></div>
                            <div><label class="text-xs font-bold text-gray-500 mb-1 block">الوصف</label><textarea id="tourism-desc" placeholder="وصف المعلم..." rows="3"></textarea></div>
                            <div><label class="text-xs font-bold text-gray-500 mb-1 block">رابط الصورة</label><input id="tourism-image" type="url" placeholder="https://..."></div>
                            <div><label class="text-xs font-bold text-gray-500 mb-1 block">التقييم</label><input id="tourism-rating" type="text" placeholder="4.8" value="4.5"></div>
                            <div><label class="text-xs font-bold text-gray-500 mb-1 block">معلومات المسافة</label><input id="tourism-distance" type="text" placeholder="10 دقائق"></div>
                            <div><label class="text-xs font-bold text-gray-500 mb-1 block">نص الشارة</label><input id="tourism-badge" type="text" placeholder="الأكثر زيارة"></div>
                            <div><label class="text-xs font-bold text-gray-500 mb-1 block">لون الشارة</label><select id="tourism-badge-color"><option value="emerald">أخضر</option><option value="amber">ذهبي</option><option value="purple">بنفسجي</option><option value="teal">تركوازي</option></select></div>
                            <div class="flex gap-2">
                                <button onclick="saveTourism()" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white py-3 rounded-xl font-bold text-sm transition-colors">💾 حفظ</button>
                                <button onclick="cancelTourismEdit()" id="tourism-cancel-btn" class="hidden bg-gray-200 hover:bg-gray-300 text-gray-600 py-3 px-4 rounded-xl font-bold text-sm transition-colors">إلغاء</button>
                            </div>
                        </div>
                    </div>
                    <div class="lg:col-span-2"><div id="tourism-list" class="space-y-3"></div></div>
                </div>
            </div>

            <!-- ===== MAYORS SECTION ===== -->
            <div id="section-mayors" class="content-section hidden fade-in">
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="lg:col-span-1 bg-white rounded-2xl p-6 shadow-md border border-gray-100 h-fit sticky top-24">
                        <h3 class="font-extrabold text-gray-800 mb-4 flex items-center gap-2">
                            <span class="iconify text-emerald-500" data-icon="lucide:plus-circle"></span>
                            <span id="mayors-form-title">إضافة رئيس</span>
                        </h3>
                        <input type="hidden" id="mayors-edit-id" value="">
                        <div class="space-y-3">
                            <div><label class="text-xs font-bold text-gray-500 mb-1 block">الاسم الكامل</label><input id="mayors-name" type="text" placeholder="السيد ..."></div>
                            <div><label class="text-xs font-bold text-gray-500 mb-1 block">فترة الولاية</label><input id="mayors-period" type="text" placeholder="2021 — الآن"></div>
                            <div><label class="text-xs font-bold text-gray-500 mb-1 block">رابط الصورة (اختياري)</label><input id="mayors-image" type="url" placeholder="https://..."></div>
                            <div class="flex gap-2">
                                <button onclick="saveMayor()" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white py-3 rounded-xl font-bold text-sm transition-colors">💾 حفظ</button>
                                <button onclick="cancelMayorEdit()" id="mayors-cancel-btn" class="hidden bg-gray-200 hover:bg-gray-300 text-gray-600 py-3 px-4 rounded-xl font-bold text-sm transition-colors">إلغاء</button>
                            </div>
                        </div>
                    </div>
                    <div class="lg:col-span-2"><div id="mayors-list" class="space-y-3"></div></div>
                </div>
            </div>

        </div>
    </div>

    <script>
        let token = localStorage.getItem('admin_token') || '';
        let activeTab = 'news';

        // ---- Init ----
        if (token) { showDashboard(); } else { showLogin(); }

        function showLogin() {
            document.getElementById('login-screen').classList.remove('hidden');
            document.getElementById('dashboard').classList.add('hidden');
        }
        function showDashboard() {
            document.getElementById('login-screen').classList.add('hidden');
            document.getElementById('dashboard').classList.remove('hidden');
            loadTab(activeTab);
        }

        // ---- Toast ----
        function adminToast(msg) {
            const t = document.getElementById('admin-toast');
            document.getElementById('admin-toast-msg').textContent = msg;
            t.classList.add('show');
            setTimeout(() => t.classList.remove('show'), 3000);
        }

        // ---- Auth ----
        async function login() {
            const username = document.getElementById('login-username').value;
            const password = document.getElementById('login-password').value;
            document.getElementById('login-error').classList.add('hidden');
            try {
                const res = await fetch('/api/auth', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, password })
                });
                const data = await res.json();
                if (data.success && data.token) {
                    token = data.token;
                    localStorage.setItem('admin_token', token);
                    showDashboard();
                } else {
                    document.getElementById('login-error').classList.remove('hidden');
                }
            } catch {
                document.getElementById('login-error').classList.remove('hidden');
            }
        }

        function logout() {
            token = '';
            localStorage.removeItem('admin_token');
            showLogin();
        }

        function authHeaders() {
            return { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token };
        }

        // ---- Tabs ----
        function switchTab(tab) {
            activeTab = tab;
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('tab-' + tab).classList.add('active');
            document.querySelectorAll('.content-section').forEach(s => s.classList.add('hidden'));
            const sec = document.getElementById('section-' + tab);
            sec.classList.remove('hidden');
            sec.classList.add('fade-in');
            loadTab(tab);
        }

        function loadTab(tab) {
            const loaders = { news: loadNews, services: loadServices, archives: loadArchives, tourism: loadTourism, mayors: loadMayors };
            if (loaders[tab]) loaders[tab]();
        }

        // ---- NEWS CRUD ----
        const catLabels = { official: '📢 إعلان رسمي', activity: '🏗️ نشاط بلدي', social: '🤝 ركن المجتمع' };
        const catColors = { official: 'red', activity: 'emerald', social: 'purple' };

        async function loadNews() {
            try {
                const res = await fetch('/api/news', { headers: authHeaders() });
                const data = await res.json();
                const list = document.getElementById('news-list');
                if (!data.success || !data.data || data.data.length === 0) {
                    list.innerHTML = '<p class="text-gray-400 text-sm text-center py-8">لا توجد أخبار بعد</p>';
                    return;
                }
                list.innerHTML = data.data.map(n => `
                    <div class="item-card">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 mb-1 flex-wrap">
                                    <span class="inline-block bg-${catColors[n.category] || 'gray'}-100 text-${catColors[n.category] || 'gray'}-700 text-[10px] font-bold px-2 py-0.5 rounded-full">${catLabels[n.category] || n.category}</span>
                                    ${n.is_pinned == 1 ? '<span class="inline-flex items-center gap-0.5 bg-emerald-50 text-emerald-600 text-[10px] font-bold px-2 py-0.5 rounded-full border border-emerald-200"><span class="iconify" data-icon="lucide:pin"></span>مثبت</span>' : ''}
                                    <span class="text-[10px] text-gray-400">${n.date}</span>
                                </div>
                                <h4 class="font-bold text-gray-800 text-sm leading-snug mb-1 truncate">${n.title}</h4>
                                <p class="text-xs text-gray-500 line-clamp-2">${(n.content || '').substring(0, 100)}...</p>
                            </div>
                            <div class="flex items-center gap-1 flex-shrink-0">
                                <button onclick="editNews(${n.id})" class="w-8 h-8 bg-blue-50 hover:bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center transition-colors" title="تعديل">
                                    <span class="iconify text-sm" data-icon="lucide:pencil"></span>
                                </button>
                                <button onclick="deleteNews(${n.id})" class="w-8 h-8 bg-red-50 hover:bg-red-100 text-red-600 rounded-lg flex items-center justify-center transition-colors" title="حذف">
                                    <span class="iconify text-sm" data-icon="lucide:trash-2"></span>
                                </button>
                            </div>
                        </div>
                    </div>
                `).join('');
            } catch { document.getElementById('news-list').innerHTML = '<p class="text-red-400 text-sm text-center py-8">تعذر التحميل</p>'; }
        }

        async function saveNews() {
            const editId = document.getElementById('news-edit-id').value;
            const body = {
                title: document.getElementById('news-title').value,
                category: document.getElementById('news-category').value,
                content: document.getElementById('news-content').value,
                image_url: document.getElementById('news-image').value,
                date: document.getElementById('news-date').value || new Date().toISOString().split('T')[0],
                is_pinned: document.getElementById('news-pinned').checked ? 1 : 0,
            };
            if (!body.title || !body.content) { adminToast('العنوان والمحتوى مطلوبان'); return; }
            try {
                const url = editId ? '/api/news/' + editId : '/api/news';
                const method = editId ? 'PUT' : 'POST';
                const res = await fetch(url, { method, headers: authHeaders(), body: JSON.stringify(body) });
                const data = await res.json();
                if (data.success) { adminToast(editId ? 'تم تعديل الخبر' : 'تم إضافة الخبر'); cancelNewsEdit(); loadNews(); }
                else adminToast('خطأ: ' + (data.error || ''));
            } catch { adminToast('تعذر الحفظ'); }
        }

        async function editNews(id) {
            try {
                const res = await fetch('/api/news', { headers: authHeaders() });
                const data = await res.json();
                const n = data.data.find(x => x.id == id);
                if (!n) return;
                document.getElementById('news-edit-id').value = n.id;
                document.getElementById('news-title').value = n.title;
                document.getElementById('news-category').value = n.category;
                document.getElementById('news-content').value = n.content;
                document.getElementById('news-image').value = n.image_url || '';
                document.getElementById('news-date').value = n.date;
                document.getElementById('news-pinned').checked = n.is_pinned == 1;
                document.getElementById('news-form-title').textContent = 'تعديل الخبر';
                document.getElementById('news-save-btn').textContent = 'تحديث';
                document.getElementById('news-cancel-btn').classList.remove('hidden');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            } catch {}
        }

        function cancelNewsEdit() {
            document.getElementById('news-edit-id').value = '';
            document.getElementById('news-title').value = '';
            document.getElementById('news-content').value = '';
            document.getElementById('news-image').value = '';
            document.getElementById('news-date').value = '';
            document.getElementById('news-pinned').checked = false;
            document.getElementById('news-form-title').textContent = 'إضافة خبر جديد';
            document.getElementById('news-save-btn').textContent = 'حفظ';
            document.getElementById('news-cancel-btn').classList.add('hidden');
        }

        async function deleteNews(id) {
            if (!confirm('هل تريد حذف هذا الخبر؟')) return;
            try {
                await fetch('/api/news/' + id, { method: 'DELETE', headers: authHeaders() });
                adminToast('تم حذف الخبر');
                loadNews();
            } catch { adminToast('تعذر الحذف'); }
        }

        // ---- SERVICES CRUD ----
        async function loadServices() {
            try {
                const res = await fetch('/api/services', { headers: authHeaders() });
                const data = await res.json();
                const list = document.getElementById('services-list');
                if (!data.success || !data.data || data.data.length === 0) { list.innerHTML = '<p class="text-gray-400 text-sm text-center py-8">لا توجد خدمات بعد</p>'; return; }
                list.innerHTML = data.data.map(s => `
                    <div class="item-card">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 mb-1"><span class="inline-block bg-${s.color || 'blue'}-100 text-${s.color || 'blue'}-700 text-[10px] font-bold px-2 py-0.5 rounded-full">${s.icon || 'file-text'}</span></div>
                                <h4 class="font-bold text-gray-800 text-sm mb-1">${s.service_name}</h4>
                                <p class="text-xs text-gray-500 line-clamp-2">${(s.required_docs || '').replace(/\|/g, ' • ')}</p>
                            </div>
                            <div class="flex items-center gap-1 flex-shrink-0">
                                <button onclick="editService(${s.id})" class="w-8 h-8 bg-blue-50 hover:bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center transition-colors"><span class="iconify text-sm" data-icon="lucide:pencil"></span></button>
                                <button onclick="deleteService(${s.id})" class="w-8 h-8 bg-red-50 hover:bg-red-100 text-red-600 rounded-lg flex items-center justify-center transition-colors"><span class="iconify text-sm" data-icon="lucide:trash-2"></span></button>
                            </div>
                        </div>
                    </div>
                `).join('');
            } catch { document.getElementById('services-list').innerHTML = '<p class="text-red-400 text-sm text-center py-8">تعذر التحميل</p>'; }
        }

        async function saveService() {
            const editId = document.getElementById('services-edit-id').value;
            const body = { service_name: document.getElementById('services-name').value, required_docs: document.getElementById('services-docs').value, pdf_link: document.getElementById('services-pdf').value, color: document.getElementById('services-color').value, icon: document.getElementById('services-icon').value };
            if (!body.service_name) { adminToast('اسم الخدمة مطلوب'); return; }
            try {
                const url = editId ? '/api/services/' + editId : '/api/services';
                const method = editId ? 'PUT' : 'POST';
                const res = await fetch(url, { method, headers: authHeaders(), body: JSON.stringify(body) });
                const data = await res.json();
                if (data.success) { adminToast(editId ? 'تم التعديل' : 'تمت الإضافة'); cancelServiceEdit(); loadServices(); }
                else adminToast('خطأ');
            } catch { adminToast('تعذر الحفظ'); }
        }

        async function editService(id) {
            const res = await fetch('/api/services', { headers: authHeaders() });
            const data = await res.json();
            const s = data.data.find(x => x.id == id); if (!s) return;
            document.getElementById('services-edit-id').value = s.id;
            document.getElementById('services-name').value = s.service_name;
            document.getElementById('services-docs').value = s.required_docs;
            document.getElementById('services-pdf').value = s.pdf_link || '';
            document.getElementById('services-color').value = s.color || 'blue';
            document.getElementById('services-icon').value = s.icon || 'file-text';
            document.getElementById('services-form-title').textContent = 'تعديل الخدمة';
            document.getElementById('services-cancel-btn').classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function cancelServiceEdit() {
            document.getElementById('services-edit-id').value = '';
            document.getElementById('services-name').value = '';
            document.getElementById('services-docs').value = '';
            document.getElementById('services-pdf').value = '';
            document.getElementById('services-color').value = 'blue';
            document.getElementById('services-icon').value = 'file-text';
            document.getElementById('services-form-title').textContent = 'إضافة خدمة';
            document.getElementById('services-cancel-btn').classList.add('hidden');
        }

        async function deleteService(id) {
            if (!confirm('حذف هذه الخدمة؟')) return;
            await fetch('/api/services/' + id, { method: 'DELETE', headers: authHeaders() });
            adminToast('تم الحذف'); loadServices();
        }

        // ---- ARCHIVES CRUD ----
        async function loadArchives() {
            try {
                const res = await fetch('/api/archives', { headers: authHeaders() });
                const data = await res.json();
                const list = document.getElementById('archives-list');
                if (!data.success || !data.data || data.data.length === 0) { list.innerHTML = '<p class="text-gray-400 text-sm text-center py-8">لا توجد صور أرشيفية بعد</p>'; return; }
                list.innerHTML = data.data.map(a => `
                    <div class="item-card">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex-1 min-w-0">
                                <h4 class="font-bold text-gray-800 text-sm mb-1">${a.title}</h4>
                                <p class="text-xs text-gray-500">${a.description || ''}</p>
                                <div class="flex gap-2 mt-2">
                                    ${a.image_old_url ? `<img src="${a.image_old_url}" class="w-16 h-12 object-cover rounded-lg vintage-filter" alt="قديم">` : '<div class="w-16 h-12 bg-gray-200 rounded-lg flex items-center justify-center text-[8px] text-gray-400">قديم</div>'}
                                    ${a.image_new_url ? `<img src="${a.image_new_url}" class="w-16 h-12 object-cover rounded-lg" alt="حديث">` : '<div class="w-16 h-12 bg-gray-200 rounded-lg flex items-center justify-center text-[8px] text-gray-400">حديث</div>'}
                                </div>
                            </div>
                            <div class="flex items-center gap-1 flex-shrink-0">
                                <button onclick="editArchive(${a.id})" class="w-8 h-8 bg-blue-50 hover:bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center transition-colors"><span class="iconify text-sm" data-icon="lucide:pencil"></span></button>
                                <button onclick="deleteArchive(${a.id})" class="w-8 h-8 bg-red-50 hover:bg-red-100 text-red-600 rounded-lg flex items-center justify-center transition-colors"><span class="iconify text-sm" data-icon="lucide:trash-2"></span></button>
                            </div>
                        </div>
                    </div>
                `).join('');
            } catch { document.getElementById('archives-list').innerHTML = '<p class="text-red-400 text-sm text-center py-8">تعذر التحميل</p>'; }
        }

        async function saveArchive() {
            const editId = document.getElementById('archives-edit-id').value;
            const body = { title: document.getElementById('archives-title').value, description: document.getElementById('archives-desc').value, image_old_url: document.getElementById('archives-old').value, image_new_url: document.getElementById('archives-new').value };
            if (!body.title) { adminToast('العنوان مطلوب'); return; }
            try {
                const url = editId ? '/api/archives/' + editId : '/api/archives';
                const method = editId ? 'PUT' : 'POST';
                const res = await fetch(url, { method, headers: authHeaders(), body: JSON.stringify(body) });
                const data = await res.json();
                if (data.success) { adminToast(editId ? 'تم التعديل' : 'تمت الإضافة'); cancelArchiveEdit(); loadArchives(); }
            } catch { adminToast('تعذر الحفظ'); }
        }

        async function editArchive(id) {
            const res = await fetch('/api/archives', { headers: authHeaders() });
            const data = await res.json();
            const a = data.data.find(x => x.id == id); if (!a) return;
            document.getElementById('archives-edit-id').value = a.id;
            document.getElementById('archives-title').value = a.title;
            document.getElementById('archives-desc').value = a.description || '';
            document.getElementById('archives-old').value = a.image_old_url || '';
            document.getElementById('archives-new').value = a.image_new_url || '';
            document.getElementById('archives-form-title').textContent = 'تعديل الصورة الأرشيفية';
            document.getElementById('archives-cancel-btn').classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function cancelArchiveEdit() {
            document.getElementById('archives-edit-id').value = '';
            document.getElementById('archives-title').value = '';
            document.getElementById('archives-desc').value = '';
            document.getElementById('archives-old').value = '';
            document.getElementById('archives-new').value = '';
            document.getElementById('archives-form-title').textContent = 'إضافة صورة أرشيفية';
            document.getElementById('archives-cancel-btn').classList.add('hidden');
        }

        async function deleteArchive(id) {
            if (!confirm('حذف؟')) return;
            await fetch('/api/archives/' + id, { method: 'DELETE', headers: authHeaders() });
            adminToast('تم الحذف'); loadArchives();
        }

        // ---- TOURISM CRUD ----
        async function loadTourism() {
            try {
                const res = await fetch('/api/tourism', { headers: authHeaders() });
                const data = await res.json();
                const list = document.getElementById('tourism-list');
                if (!data.success || !data.data || data.data.length === 0) { list.innerHTML = '<p class="text-gray-400 text-sm text-center py-8">لا توجد معالم بعد</p>'; return; }
                list.innerHTML = data.data.map(t => `
                    <div class="item-card">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="inline-block bg-${t.badge_color || 'emerald'}-100 text-${t.badge_color || 'emerald'}-700 text-[10px] font-bold px-2 py-0.5 rounded-full">${t.badge_text || ''}</span>
                                    <span class="text-[10px] text-gray-400">⭐ ${t.rating || ''}</span>
                                </div>
                                <h4 class="font-bold text-gray-800 text-sm mb-0.5">${t.name}</h4>
                                <p class="text-[10px] text-gray-400 mb-1">${t.subtitle || ''}</p>
                                <p class="text-xs text-gray-500 line-clamp-2">${(t.description || '').substring(0, 80)}...</p>
                            </div>
                            <div class="flex items-center gap-1 flex-shrink-0">
                                <button onclick="editTourism(${t.id})" class="w-8 h-8 bg-blue-50 hover:bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center transition-colors"><span class="iconify text-sm" data-icon="lucide:pencil"></span></button>
                                <button onclick="deleteTourism(${t.id})" class="w-8 h-8 bg-red-50 hover:bg-red-100 text-red-600 rounded-lg flex items-center justify-center transition-colors"><span class="iconify text-sm" data-icon="lucide:trash-2"></span></button>
                            </div>
                        </div>
                    </div>
                `).join('');
            } catch { document.getElementById('tourism-list').innerHTML = '<p class="text-red-400 text-sm text-center py-8">تعذر التحميل</p>'; }
        }

        async function saveTourism() {
            const editId = document.getElementById('tourism-edit-id').value;
            const body = { name: document.getElementById('tourism-name').value, subtitle: document.getElementById('tourism-subtitle').value, description: document.getElementById('tourism-desc').value, image_url: document.getElementById('tourism-image').value, rating: document.getElementById('tourism-rating').value, distance_info: document.getElementById('tourism-distance').value, badge_text: document.getElementById('tourism-badge').value, badge_color: document.getElementById('tourism-badge-color').value };
            if (!body.name) { adminToast('الاسم مطلوب'); return; }
            try {
                const url = editId ? '/api/tourism/' + editId : '/api/tourism';
                const method = editId ? 'PUT' : 'POST';
                const res = await fetch(url, { method, headers: authHeaders(), body: JSON.stringify(body) });
                const data = await res.json();
                if (data.success) { adminToast(editId ? 'تم التعديل' : 'تمت الإضافة'); cancelTourismEdit(); loadTourism(); }
            } catch { adminToast('تعذر الحفظ'); }
        }

        async function editTourism(id) {
            const res = await fetch('/api/tourism', { headers: authHeaders() });
            const data = await res.json();
            const t = data.data.find(x => x.id == id); if (!t) return;
            document.getElementById('tourism-edit-id').value = t.id;
            document.getElementById('tourism-name').value = t.name;
            document.getElementById('tourism-subtitle').value = t.subtitle || '';
            document.getElementById('tourism-desc').value = t.description || '';
            document.getElementById('tourism-image').value = t.image_url || '';
            document.getElementById('tourism-rating').value = t.rating || '4.5';
            document.getElementById('tourism-distance').value = t.distance_info || '';
            document.getElementById('tourism-badge').value = t.badge_text || '';
            document.getElementById('tourism-badge-color').value = t.badge_color || 'emerald';
            document.getElementById('tourism-form-title').textContent = 'تعديل المعلم';
            document.getElementById('tourism-cancel-btn').classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function cancelTourismEdit() {
            document.getElementById('tourism-edit-id').value = '';
            document.getElementById('tourism-name').value = '';
            document.getElementById('tourism-subtitle').value = '';
            document.getElementById('tourism-desc').value = '';
            document.getElementById('tourism-image').value = '';
            document.getElementById('tourism-rating').value = '4.5';
            document.getElementById('tourism-distance').value = '';
            document.getElementById('tourism-badge').value = '';
            document.getElementById('tourism-badge-color').value = 'emerald';
            document.getElementById('tourism-form-title').textContent = 'إضافة معلم سياحي';
            document.getElementById('tourism-cancel-btn').classList.add('hidden');
        }

        async function deleteTourism(id) {
            if (!confirm('حذف؟')) return;
            await fetch('/api/tourism/' + id, { method: 'DELETE', headers: authHeaders() });
            adminToast('تم الحذف'); loadTourism();
        }

        // ---- MAYORS CRUD ----
        async function loadMayors() {
            try {
                const res = await fetch('/api/mayors', { headers: authHeaders() });
                const data = await res.json();
                const list = document.getElementById('mayors-list');
                if (!data.success || !data.data || data.data.length === 0) { list.innerHTML = '<p class="text-gray-400 text-sm text-center py-8">لا توجد بيانات بعد</p>'; return; }
                list.innerHTML = data.data.map(m => `
                    <div class="item-card">
                        <div class="flex items-center justify-between gap-3">
                            <div class="flex items-center gap-3 flex-1 min-w-0">
                                ${m.image_url ? `<img src="${m.image_url}" class="w-12 h-12 rounded-full object-cover border-2 border-emerald-200 flex-shrink-0">` : `<div class="w-12 h-12 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0"><span class="iconify text-emerald-500 text-xl" data-icon="lucide:user"></span></div>`}
                                <div class="min-w-0">
                                    <h4 class="font-bold text-gray-800 text-sm truncate">${m.name}</h4>
                                    <p class="text-xs text-gray-500">${m.period}</p>
                                </div>
                            </div>
                            <div class="flex items-center gap-1 flex-shrink-0">
                                <button onclick="editMayor(${m.id})" class="w-8 h-8 bg-blue-50 hover:bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center transition-colors"><span class="iconify text-sm" data-icon="lucide:pencil"></span></button>
                                <button onclick="deleteMayor(${m.id})" class="w-8 h-8 bg-red-50 hover:bg-red-100 text-red-600 rounded-lg flex items-center justify-center transition-colors"><span class="iconify text-sm" data-icon="lucide:trash-2"></span></button>
                            </div>
                        </div>
                    </div>
                `).join('');
            } catch { document.getElementById('mayors-list').innerHTML = '<p class="text-red-400 text-sm text-center py-8">تعذر التحميل</p>'; }
        }

        async function saveMayor() {
            const editId = document.getElementById('mayors-edit-id').value;
            const body = { name: document.getElementById('mayors-name').value, period: document.getElementById('mayors-period').value, image_url: document.getElementById('mayors-image').value };
            if (!body.name || !body.period) { adminToast('الاسم والفترة مطلوبان'); return; }
            try {
                const url = editId ? '/api/mayors/' + editId : '/api/mayors';
                const method = editId ? 'PUT' : 'POST';
                const res = await fetch(url, { method, headers: authHeaders(), body: JSON.stringify(body) });
                const data = await res.json();
                if (data.success) { adminToast(editId ? 'تم التعديل' : 'تمت الإضافة'); cancelMayorEdit(); loadMayors(); }
            } catch { adminToast('تعذر الحفظ'); }
        }

        async function editMayor(id) {
            const res = await fetch('/api/mayors', { headers: authHeaders() });
            const data = await res.json();
            const m = data.data.find(x => x.id == id); if (!m) return;
            document.getElementById('mayors-edit-id').value = m.id;
            document.getElementById('mayors-name').value = m.name;
            document.getElementById('mayors-period').value = m.period;
            document.getElementById('mayors-image').value = m.image_url || '';
            document.getElementById('mayors-form-title').textContent = 'تعديل الرئيس';
            document.getElementById('mayors-cancel-btn').classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function cancelMayorEdit() {
            document.getElementById('mayors-edit-id').value = '';
            document.getElementById('mayors-name').value = '';
            document.getElementById('mayors-period').value = '';
            document.getElementById('mayors-image').value = '';
            document.getElementById('mayors-form-title').textContent = 'إضافة رئيس';
            document.getElementById('mayors-cancel-btn').classList.add('hidden');
        }

        async function deleteMayor(id) {
            if (!confirm('حذف؟')) return;
            await fetch('/api/mayors/' + id, { method: 'DELETE', headers: authHeaders() });
            adminToast('تم الحذف'); loadMayors();
        }
    </script>
</body>
</html>
</file>

