                    <span class="iconify text-base md:text-lg" data-icon="lucide:map"></span>
                    دليل البلدية
                </a>
            </div>
        </div>
    </section>

    <!-- ============ WIDGETS & STATS ============ -->
    <!-- ✅ FIX: -mt-16 أزيل لتجنب التداخل مع الأزرار -->
    <section class="relative z-20 max-w-7xl mx-auto px-4 mt-8 mb-10">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-6">
            <div class="stat-card bg-white rounded-2xl p-6 shadow-lg border border-emerald-100 text-center hover:shadow-xl">
