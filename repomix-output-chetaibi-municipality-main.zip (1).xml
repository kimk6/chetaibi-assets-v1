    <script>
        const mobileBtn = document.getElementById('mobile-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        mobileBtn.addEventListener('click', () => mobileMenu.classList.toggle('open'));
        mobileMenu.querySelectorAll('a').forEach(l => l.addEventListener('click', () => mobileMenu.classList.remove('open')));

        const mainNav = document.getElementById('main-nav');
        function handleMobileNav() {
            if (window.innerWidth < 768) {
                if (window.scrollY > 300) mainNav.classList.add('nav-visible');
                else { mainNav.classList.remove('nav-visible'); mobileMenu.classList.remove('open'); }
            } else mainNav.classList.remove('nav-visible');
        }
        window.addEventListener('scroll', handleMobileNav, { passive: true });
        window.addEventListener('resize', handleMobileNav, { passive: true });
        handleMobileNav();

        function switchTab(t) {
            document.querySelectorAll('.news-content').forEach(c => c.classList.add('hidden'));
            document.querySelectorAll('.news-tab').forEach(b => b.classList.remove('active'));
            document.getElementById('content-' + t).classList.remove('hidden');
            document.getElementById('tab-' + t).classList.add('active');
        }

        function showToast(m) { const t = document.getElementById('toast'); document.getElementById('toast-msg').textContent = m; t.classList.add('show'); setTimeout(() => t.classList.remove('show'), 3000); }
        function downloadForm(n) { showToast('جاري تحميل استمارة: ' + n); }

        const backTopBtn = document.getElementById('back-top');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 500) { backTopBtn.classList.remove('opacity-0','translate-y-4','pointer-events-none'); backTopBtn.classList.add('opacity-100','translate-y-0'); }
            else { backTopBtn.classList.add('opacity-0','translate-y-4','pointer-events-none'); backTopBtn.classList.remove('opacity-100','translate-y-0'); }
        });

        const sections = document.querySelectorAll('section[id]');
        const navLinks = document.querySelectorAll('.nav-link');
        window.addEventListener('scroll', () => {
            let c = '';
            sections.forEach(s => { if (window.scrollY >= s.offsetTop - 100) c = s.id; });
            navLinks.forEach(l => { l.classList.remove('active-link'); if (l.getAttribute('href') === '#' + c) l.classList.add('active-link'); });
        });

        // ✅ إحداثيات صحيحة — ميناء شطايبي
        const LAT = 37.0850;
        const LON = 7.2550;

        async function fetchWeather() {
            try {
                const r = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${LAT}&longitude=${LON}&current=temperature_2m,relative_humidity_2m,wind_speed_10m,weather_code&daily=temperature_2m_max,temperature_2m_min&timezone=Africa%2FAlgiers&forecast_days=1`);
                const d = await r.json();
                const cu = d.current;
                const dl = d.daily;
                const wm = {0:{i:'☀️',d:'صافٍ'},1:{i:'🌤️',d:'غائم خفيف'},2:{i:'⛅',d:'غائم جزئياً'},3:{i:'☁️',d:'غائم'},45:{i:'🌫️',d:'ضبابي'},48:{i:'🌫️',d:'ضبابي كثيف'},51:{i:'🌦️',d:'رذاذ خفيف'},53:{i:'🌦️',d:'رذاذ'},55:{i:'🌧️',d:'رذاذ كثيف'},61:{i:'🌧️',d:'ممطر'},63:{i:'🌧️',d:'مطر متوسط'},65:{i:'🌧️',d:'مطر غزير'},80:{i:'🌦️',d:'زخات خفيفة'},81:{i:'🌧️',d:'زخات'},82:{i:'⛈️',d:'زخات عنيفة'},95:{i:'⛈️',d:'عاصفة رعدية'},99:{i:'⛈️',d:'عاصفة شديدة'}};
                const w = wm[cu.weather_code] || {i:'🌡️',d:'متغير'};
                document.getElementById('weather-temp').textContent = Math.round(cu.temperature_2m) + '°';
                document.getElementById('weather-icon').textContent = w.i;
                document.getElementById('weather-desc').textContent = w.d;
                document.getElementById('weather-humidity').textContent = cu.relative_humidity_2m + '%';
                document.getElementById('weather-wind').textContent = Math.round(cu.wind_speed_10m) + ' كم/س';
                document.getElementById('weather-max').textContent = Math.round(dl.temperature_2m_max[0]) + '°';
                document.getElementById('weather-min').textContent = Math.round(dl.temperature_2m_min[0]) + '°';
            } catch { document.getElementById('weather-desc').textContent = 'تعذر التحميل'; }
        }

        async function fetchSeaState() {
            try {
                // ✅ API البحر الصحيح مع الإحداثيات الدقيقة
                const r = await fetch(`https://marine-api.open-meteo.com/v1/marine?latitude=${LAT}&longitude=${LON}&current=wave_height,wave_period,wave_direction&timezone=Africa%2FAlgiers`);
                const d = await r.json();
                const cu = d.current;
                if (!cu || cu.wave_height === null || cu.wave_height === undefined) {
                    document.getElementById('sea-state').textContent = '--';
                    document.getElementById('sea-desc').textContent = 'البيانات غير متاحة حالياً';
                    return;
                }
                const wh = cu.wave_height.toFixed(1);
                // اتجاه الموج
                const dirDeg = cu.wave_direction;
                const dirs = ['شمال','شمال شرقي','شرقي','جنوب شرقي','جنوبي','جنوب غربي','غربي','شمال غربي'];
                const dirLabel = dirDeg != null ? dirs[Math.round(dirDeg / 45) % 8] : '--';
                // حالة البحر
                let st, si, sd;
                const v = parseFloat(wh);
                if (v < 0.5)      { st = 'هادئ';         si = '🌊'; sd = 'البحر هادئ — مناسب للسباحة'; }
                else if (v < 1.0) { st = 'هادئ نسبياً';  si = '🌅'; sd = 'البحر هادئ نسبياً — مناسب'; }
                else if (v < 1.5) { st = 'معتدل';        si = '🌊'; sd = 'البحر معتدل — حذر للصيادين'; }
                else if (v < 2.5) { st = 'مضطرب';        si = '⚠️'; sd = 'البحر مضطرب — يُنصح بالحذر'; }
                else              { st = 'عاصف';          si = '🔴'; sd = 'البحر عاصف — يُمنع الخروج'; }

                document.getElementById('sea-state').textContent = st;
                document.getElementById('sea-icon').textContent = si;
                document.getElementById('sea-desc').textContent = sd;
                document.getElementById('sea-wave').textContent = wh;
                document.getElementById('sea-water-temp').textContent = '19'; // تقديري لشهر الصيف — يمكن استبداله بـ API متخصص
                document.getElementById('sea-dir').textContent = dirLabel;
            } catch (e) {
                document.getElementById('sea-state').textContent = '--';
                document.getElementById('sea-desc').textContent = 'تعذر التحميل';
            }
        }

        const categoryMap = { official: 'announcements', activity: 'activities', social: 'community' };
        const catStyles = {
            official: { label: 'إعلان عاجل', grad: 'from-red-500 to-red-700', badge: 'bg-red-100 text-red-700', icon: 'lucide:megaphone' },
            activity: { label: 'نشاط', grad: 'from-emerald-500 to-emerald-700', badge: 'bg-emerald-100 text-emerald-700', icon: 'lucide:clipboard-list' },
            social: { label: 'مجتمع', grad: 'from-purple-500 to-purple-700', badge: 'bg-purple-100 text-purple-700', icon: 'lucide:heart-handshake' }
        };

        async function loadNews() {
            const loading = document.getElementById('news-loading');
            try {
                const r = await fetch('/api/news');
                const d = await r.json();
                loading.classList.add('hidden');
                if (!d.success || !d.data || d.data.length === 0) {
                    ['announcements', 'activities', 'community'].forEach(t => { document.getElementById('content-' + t).innerHTML = '<p class="text-gray-400 text-sm text-center py-8 col-span-full">لا توجد أخبار حالياً</p>'; });
                    document.getElementById('content-announcements').classList.remove('hidden'); return;
                }
                const grouped = { announcements: [], activities: [], community: [] };
                d.data.forEach(n => { const t = categoryMap[n.category] || 'announcements'; grouped[t].push(n); });
                Object.entries(grouped).forEach(([tab, items]) => {
                    const c = document.getElementById('content-' + tab);
                    if (items.length === 0) { c.innerHTML = '<p class="text-gray-400 text-sm text-center py-8 col-span-full">لا توجد أخبار في هذا القسم</p>'; return; }
                    c.innerHTML = items.map(n => {
                        const s = catStyles[n.category] || catStyles.official;
                        const img = n.image_url || '';
                        const isPinned = n.is_pinned == 1;
                        const pinBadge = isPinned ? '<div class="pin-badge"><span class="iconify text-sm" data-icon="lucide:pin"></span></div>' : '';
                        const pinLabel = isPinned ? '<span class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-600 text-[10px] font-bold px-2 py-0.5 rounded-full border border-emerald-200"><span class="iconify" data-icon="lucide:pin"></span>مثبت</span>' : '';
                        const pinBorder = isPinned ? 'border-emerald-300 ring-1 ring-emerald-200' : 'border-gray-100';
                        return `<article class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-shadow border ${pinBorder} relative">
                            ${img ? `<div class="h-48 overflow-hidden relative">${pinBadge}<img src="${img}" alt="${n.title}" class="w-full h-full object-cover"></div>` : `<div class="h-48 bg-gradient-to-bl ${s.grad} flex items-center justify-center relative">${pinBadge}<span class="iconify text-white text-6xl" data-icon="${s.icon}"></span></div>`}
                            <div class="p-5">
                                <div class="flex items-center gap-2 mb-3 flex-wrap">
                                    <span class="inline-block ${s.badge} text-xs font-bold px-3 py-1 rounded-full">${s.label}</span>
                                    ${pinLabel}
                                </div>
                                <h4 class="font-bold text-gray-800 mb-2 leading-snug">${n.title}</h4>
                                <p class="text-sm text-gray-500 mb-4 leading-relaxed">${(n.content || '').substring(0, 120)}...</p>
                                <div class="flex items-center justify-between">
                                    <span class="text-xs text-gray-400 flex items-center gap-1"><span class="iconify" data-icon="lucide:calendar"></span>${n.date}</span>
                                    <a href="/news/${n.id}" class="text-emerald-600 text-sm font-bold hover:text-emerald-700">اقرأ المزيد ←</a>
                                </div>
                            </div>
                        </article>`;
                    }).join('');
                });
                const fa = grouped.announcements.length > 0 ? 'announcements' : grouped.activities.length > 0 ? 'activities' : 'community';
                document.getElementById('content-' + fa).classList.remove('hidden');
                document.querySelectorAll('.news-tab').forEach(t => t.classList.remove('active'));
                document.getElementById('tab-' + fa).classList.add('active');
            } catch (e) {
                loading.classList.add('hidden');
                ['announcements', 'activities', 'community'].forEach(t => { document.getElementById('content-' + t).innerHTML = '<p class="text-red-400 text-sm text-center py-8 col-span-full">تعذر تحميل الأخبار</p>'; });
                document.getElementById('content-announcements').classList.remove('hidden');
            }
        }

        fetchWeather();
        fetchSeaState();
        loadNews();
        // تحديث كل 15 دقيقة
        setInterval(() => { fetchWeather(); fetchSeaState(); }, 900000);
    </script>
</body>
</html>
