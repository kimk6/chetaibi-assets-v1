// REPO SIZE
// ═══════════════════════════════
async function loadRepoSize(){
    const icon=document.getElementById('repo-refresh-icon');
    icon.classList.add('spin');
    try {
        const res=await fetch('/api/media?action=repo-size',{headers:authHeaders()});
        const d=await res.json(); icon.classList.remove('spin');
        if(!d.success) return;
        const{size_mb,percentage,repo,warning,critical,message}=d.data;
        document.getElementById('repo-name-badge').textContent=repo;
        document.getElementById('repo-size-text').textContent=size_mb+' MB / '+d.data.max_mb+' MB';
        const fill=document.getElementById('repo-bar-fill');
        fill.style.width=Math.min(percentage,100)+'%';
        fill.classList.remove('warn','danger');
        if(critical) fill.classList.add('danger'); else if(warning) fill.classList.add('warn');
        const warn=document.getElementById('repo-warning');
        if(warning||critical){ warn.classList.remove('hidden'); document.getElementById('repo-warning-msg').textContent=message; }
        else warn.classList.add('hidden');
    } catch{ icon.classList.remove('spin'); }
}

