    try{const res=await fetch(editId?'/api/tourism?id='+editId:'/api/tourism',{method:editId?'PUT':'POST',headers:authHeaders(),body:JSON.stringify(body)});const d=await res.json();if(d.success){adminToast(editId?'تم التعديل':'تمت الإضافة');cancelTourismEdit();loadTourism();}else adminToast('خطأ: '+(d.error||''));}catch(e){adminToast('تعذر الحفظ: '+e.message);}
}
async function editTourism(id){
    const res=await fetch('/api/tourism',{headers:authHeaders()});const d=await res.json();const t=d.data.find(x=>x.id==id);if(!t)return;
    document.getElementById('tourism-edit-id').value=t.id;document.getElementById('tourism-name').value=t.name;document.getElementById('tourism-subtitle').value=t.subtitle||'';document.getElementById('tourism-desc').value=t.description||'';document.getElementById('tourism-image').value=t.image_url||'';document.getElementById('tourism-rating').value=t.rating||'4.5';document.getElementById('tourism-distance').value=t.distance_info||'';document.getElementById('tourism-badge').value=t.badge_text||'';document.getElementById('tourism-badge-color').value=t.badge_color||'emerald';document.getElementById('tourism-image-manual').value=t.image_url||'';
    if(t.image_url){document.getElementById('tourism-img-placeholder').classList.add('hidden');document.getElementById('tourism-img-img').src=t.image_url;document.getElementById('tourism-img-preview').classList.remove('hidden');document.getElementById('tourism-img-widget').classList.add('has-image');}
    document.getElementById('tourism-form-title').textContent='تعديل المعلم';document.getElementById('tourism-cancel-btn').classList.remove('hidden');window.scrollTo({top:0,behavior:'smooth'});
}
function cancelTourismEdit(){
    ['tourism-edit-id','tourism-name','tourism-subtitle','tourism-desc','tourism-image','tourism-image-manual','tourism-distance','tourism-badge'].forEach(id=>document.getElementById(id).value='');
    document.getElementById('tourism-rating').value='4.5';document.getElementById('tourism-badge-color').value='emerald';
    clearWidget('tourism-img','tourism-image','tourism-image-manual');
    document.getElementById('tourism-form-title').textContent='إضافة معلم سياحي';document.getElementById('tourism-cancel-btn').classList.add('hidden');
}
async function deleteTourism(id){if(!confirm('حذف؟'))return;try{await fetch('/api/tourism?id='+id,{method:'DELETE',headers:authHeaders()});adminToast('تم الحذف');loadTourism();}catch{adminToast('تعذر الحذف');}}

// ═══════════════════════════════
// MAYORS
// ═══════════════════════════════
async function loadMayors(){
    try{
        const res=await fetch('/api/mayors',{headers:authHeaders()});const d=await res.json();const list=document.getElementById('mayors-list');
        if(!d.success||!d.data?.length){list.innerHTML='<p class="text-gray-400 text-sm text-center py-8">لا توجد بيانات بعد</p>';return;}
        list.innerHTML=d.data.map(m=>`
            <div class="item-card"><div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-3 flex-1 min-w-0">
                    ${m.image_url?`<img src="${m.image_url}" class="w-12 h-12 rounded-full object-cover border-2 border-emerald-200 flex-shrink-0">`:'<div class="w-12 h-12 rounded-full bg-emerald-100 flex items-center justify-center flex-shrink-0"><span class="iconify text-emerald-500 text-xl" data-icon="lucide:user"></span></div>'}
                    <div class="min-w-0"><h4 class="font-bold text-gray-800 text-sm truncate">${m.name}</h4><p class="text-xs text-gray-500">${m.period}</p></div>
                </div>
                <div class="flex items-center gap-1 flex-shrink-0">
                    <button onclick="editMayor(${m.id})" class="w-8 h-8 bg-blue-50 hover:bg-blue-100 text-blue-600 rounded-lg flex items-center justify-center"><span class="iconify text-sm" data-icon="lucide:pencil"></span></button>
                    <button onclick="deleteMayor(${m.id})" class="w-8 h-8 bg-red-50 hover:bg-red-100 text-red-600 rounded-lg flex items-center justify-center"><span class="iconify text-sm" data-icon="lucide:trash-2"></span></button>
                </div>
            </div></div>`).join('');
    } catch { document.getElementById('mayors-list').innerHTML='<p class="text-red-400 text-sm text-center py-8">تعذر التحميل</p>'; }
}
async function saveMayor(){
    const editId=document.getElementById('mayors-edit-id').value;
    const body={name:document.getElementById('mayors-name').value,period:document.getElementById('mayors-period').value,image_url:document.getElementById('mayors-image').value};
    if(!body.name||!body.period){adminToast('الاسم والفترة مطلوبان');return;}
    try{const res=await fetch(editId?'/api/mayors?id='+editId:'/api/mayors',{method:editId?'PUT':'POST',headers:authHeaders(),body:JSON.stringify(body)});const d=await res.json();if(d.success){adminToast(editId?'تم التعديل':'تمت الإضافة');cancelMayorEdit();loadMayors();}else adminToast('خطأ: '+(d.error||''));}catch(e){adminToast('تعذر الحفظ: '+e.message);}
}
async function editMayor(id){
    const res=await fetch('/api/mayors',{headers:authHeaders()});const d=await res.json();const m=d.data.find(x=>x.id==id);if(!m)return;
    document.getElementById('mayors-edit-id').value=m.id;document.getElementById('mayors-name').value=m.name;document.getElementById('mayors-period').value=m.period;document.getElementById('mayors-image').value=m.image_url||'';document.getElementById('mayors-image-manual').value=m.image_url||'';
    if(m.image_url){document.getElementById('mayors-img-placeholder').classList.add('hidden');document.getElementById('mayors-img-img').src=m.image_url;document.getElementById('mayors-img-preview').classList.remove('hidden');document.getElementById('mayors-img-widget').classList.add('has-image');}
    document.getElementById('mayors-form-title').textContent='تعديل الرئيس';document.getElementById('mayors-cancel-btn').classList.remove('hidden');window.scrollTo({top:0,behavior:'smooth'});
}
function cancelMayorEdit(){
    ['mayors-edit-id','mayors-name','mayors-period','mayors-image','mayors-image-manual'].forEach(id=>document.getElementById(id).value='');
    clearWidget('mayors-img','mayors-image','mayors-image-manual');
    document.getElementById('mayors-form-title').textContent='إضافة رئيس';document.getElementById('mayors-cancel-btn').classList.add('hidden');
}
async function deleteMayor(id){if(!confirm('حذف؟'))return;try{await fetch('/api/mayors?id='+id,{method:'DELETE',headers:authHeaders()});adminToast('تم الحذف');loadMayors();}catch{adminToast('تعذر الحذف');}}
</script>
</body>
</html>
