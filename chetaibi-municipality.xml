<script>
// ── NAV ──
const mobileBtn=document.getElementById('mobile-btn');
const mobileMenu=document.getElementById('mobile-menu');
mobileBtn.addEventListener('click',()=>mobileMenu.classList.toggle('open'));
mobileMenu.querySelectorAll('a').forEach(l=>l.addEventListener('click',()=>mobileMenu.classList.remove('open')));
const mainNav=document.getElementById('main-nav');
function handleMobileNav(){if(window.innerWidth<768){if(window.scrollY>300)mainNav.classList.add('nav-visible');else{mainNav.classList.remove('nav-visible');mobileMenu.classList.remove('open');}}else mainNav.classList.remove('nav-visible');}
window.addEventListener('scroll',handleMobileNav,{passive:true});
window.addEventListener('resize',handleMobileNav,{passive:true});
handleMobileNav();

// ── TABS ──
function switchTab(t){document.querySelectorAll('.news-content').forEach(c=>c.classList.add('hidden'));document.querySelectorAll('.news-tab').forEach(b=>b.classList.remove('active'));document.getElementById('content-'+t).classList.remove('hidden');document.getElementById('tab-'+t).classList.add('active');}

// ── TOAST / FORM ──
function showToast(m){const t=document.getElementById('toast');document.getElementById('toast-msg').textContent=m;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),3000);}
function downloadForm(n){showToast('جاري تحميل استمارة: '+n);}

// ── BACK TO TOP ──
const backTopBtn=document.getElementById('back-top');
window.addEventListener('scroll',()=>{if(window.scrollY>500){backTopBtn.classList.remove('opacity-0','translate-y-4','pointer-events-none');backTopBtn.classList.add('opacity-100','translate-y-0');}else{backTopBtn.classList.add('opacity-0','translate-y-4','pointer-events-none');backTopBtn.classList.remove('opacity-100','translate-y-0');}});

// ── ACTIVE LINK ──
const sections=document.querySelectorAll('section[id]');
const navLinks=document.querySelectorAll('.nav-link');
window.addEventListener('scroll',()=>{let c='';sections.forEach(s=>{if(window.scrollY>=s.offsetTop-100)c=s.id;});navLinks.forEach(l=>{l.classList.remove('active-link');if(l.getAttribute('href')==='#'+c)l.classList.add('active-link');});});

// ── ✅ 8: EXTRA SERVICES TOGGLE ──
let extraOpen=false;
let extraLoaded=false;
async function toggleExtraServices(){
    const el=document.getElementById('extra-services');
    const icon=document.getElementById('more-services-icon');
    const text=document.getElementById('more-services-text');
    if(!extraLoaded){
        // جلب الخدمات الإضافية من API (بعد أول 3)
        try{
            const res=await fetch('/api/services');
            const d=await res.json();
            if(d.success&&d.data&&d.data.length>3){
                const extra=d.data.slice(3);
                const colorMap={blue:'from-blue-600 to-blue-800',emerald:'from-emerald-600 to-emerald-800',amber:'from-amber-600 to-amber-800',purple:'from-purple-600 to-purple-800'};
                const iconMap={blue:'text-blue-700 bg-blue-100',emerald:'text-emerald-700 bg-emerald-100',amber:'text-amber-700 bg-amber-100',purple:'text-purple-700 bg-purple-100'};
                document.getElementById('extra-services-grid').innerHTML=extra.map(s=>`
                    <div class="service-card bg-white rounded-2xl border border-gray-200 overflow-hidden shadow-md">
                        <div class="bg-gradient-to-l ${colorMap[s.color]||colorMap.emerald} p-6 text-white text-center"><div class="w-16 h-16 bg-white/20 rounded-2xl flex items-center justify-center mx-auto mb-3"><span class="iconify text-3xl" data-icon="lucide:${s.icon||'file-text'}"></span></div><h3 class="text-xl font-extrabold">${s.service_name}</h3></div>
                        <div class="p-6"><h4 class="font-bold text-gray-700 mb-3 flex items-center gap-2"><span class="iconify text-emerald-500" data-icon="lucide:file-check-2"></span>الوثائق المطلوبة</h4><ul class="space-y-2.5 mb-6">${(s.required_docs||'').split('|').map(d=>`<li class="flex items-start gap-2 text-sm text-gray-600"><span class="w-5 h-5 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5 text-xs font-bold">✓</span>${d.trim()}</li>`).join('')}</ul>${s.pdf_link?`<a href="${s.pdf_link}" target="_blank" class="w-full inline-flex items-center justify-center gap-2 bg-emerald-600 hover:bg-emerald-700 text-white py-3 px-4 rounded-xl font-bold text-sm transition-colors shadow-md"><span class="iconify text-lg" data-icon="lucide:download"></span>تحميل الاستمارة</a>`:''}</div>
                    </div>`).join('');
            } else {
                document.getElementById('extra-services-grid').innerHTML='<p class="col-span-3 text-center text-gray-400 text-sm py-6">لا توجد خدمات إضافية</p>';
            }
        } catch{}
        extraLoaded=true;
    }
    extraOpen=!extraOpen;
    el.classList.toggle('open',extraOpen);
    icon.setAttribute('data-icon', extraOpen?'lucide:chevrons-up':'lucide:chevrons-down');
    text.textContent=extraOpen?'إخفاء الخدمات الإضافية':'عرض المزيد من الخدمات';
}

// ── COORDS ──
const LAT=37.0850, LON=7.2550;

// ── ✅ 1: WEATHER ذكي — نهار/ليل ──
async function fetchWeather(){
    try{
        const r=await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${LAT}&longitude=${LON}&current=temperature_2m,relative_humidity_2m,wind_speed_10m,weather_code,is_day&daily=temperature_2m_max,temperature_2m_min&timezone=Africa%2FAlgiers&forecast_days=1`);
        const d=await r.json();
        const cu=d.current, dl=d.daily;
        const isDay=cu.is_day===1;

        // أيقونات نهارية/ليلية
        const wmDay ={0:{i:'☀️',d:'صافٍ'},1:{i:'🌤️',d:'غائم خفيف'},2:{i:'⛅',d:'غائم جزئياً'},3:{i:'☁️',d:'غائم'},45:{i:'🌫️',d:'ضبابي'},48:{i:'🌫️',d:'ضبابي'},51:{i:'🌦️',d:'رذاذ خفيف'},53:{i:'🌦️',d:'رذاذ'},55:{i:'🌧️',d:'رذاذ كثيف'},61:{i:'🌧️',d:'ممطر'},63:{i:'🌧️',d:'مطر متوسط'},65:{i:'🌧️',d:'مطر غزير'},80:{i:'🌦️',d:'زخات'},81:{i:'🌧️',d:'زخات'},82:{i:'⛈️',d:'عاصفة'},95:{i:'⛈️',d:'عاصفة رعدية'}};
        const wmNight={0:{i:'🌕',d:'صافٍ'},1:{i:'🌙',d:'غائم خفيف'},2:{i:'🌥️',d:'غائم جزئياً'},3:{i:'☁️',d:'غائم'},45:{i:'🌫️',d:'ضبابي'},48:{i:'🌫️',d:'ضبابي'},51:{i:'🌧️',d:'رذاذ خفيف'},53:{i:'🌧️',d:'رذاذ'},55:{i:'🌧️',d:'رذاذ كثيف'},61:{i:'🌧️',d:'ممطر'},63:{i:'🌧️',d:'مطر'},65:{i:'🌧️',d:'مطر غزير'},80:{i:'🌧️',d:'زخات'},81:{i:'🌧️',d:'زخات'},82:{i:'⛈️',d:'عاصفة'},95:{i:'⛈️',d:'عاصفة رعدية'}};
        const wm=isDay?wmDay:wmNight;
        const w=wm[cu.weather_code]||{i:isDay?'🌡️':'🌙',d:'متغير'};

        document.getElementById('weather-temp').textContent=Math.round(cu.temperature_2m)+'°';
        document.getElementById('weather-icon').textContent=w.i;
        document.getElementById('weather-desc').textContent=w.d;
        document.getElementById('weather-humidity').textContent=cu.relative_humidity_2m+'%';
        document.getElementById('weather-wind').textContent=Math.round(cu.wind_speed_10m)+' كم/س';
        document.getElementById('weather-max').textContent=Math.round(dl.temperature_2m_max[0])+'°';
        document.getElementById('weather-min').textContent=Math.round(dl.temperature_2m_min[0])+'°';

        // ✅ تغيير الأيقونة والألوان في الهيدر حسب النهار/الليل
        const hdrIcon=document.getElementById('weather-header-icon');
        const hdrBg=document.getElementById('weather-icon-bg');
        if(isDay){
            hdrIcon.setAttribute('data-icon','lucide:sun');
            hdrIcon.className='iconify text-amber-500 text-2xl';
            hdrBg.className='w-12 h-12 bg-amber-100 rounded-xl flex items-center justify-center transition-colors duration-500';
            document.getElementById('weather-time-label').textContent='نهاراً — '+Math.round(cu.temperature_2m)+'°C';
        } else {
            hdrIcon.setAttribute('data-icon','lucide:moon');
            hdrIcon.className='iconify text-indigo-400 text-2xl';
            hdrBg.className='w-12 h-12 bg-indigo-100 rounded-xl flex items-center justify-center transition-colors duration-500';
            document.getElementById('weather-time-label').textContent='ليلاً — '+Math.round(cu.temperature_2m)+'°C';
        }
    } catch { document.getElementById('weather-desc').textContent='تعذر التحميل'; }
}

// ── ✅ 1: SEA — نهار/ليل ──
async function fetchSeaState(){
    try{
        const r=await fetch(`https://marine-api.open-meteo.com/v1/marine?latitude=${LAT}&longitude=${LON}&current=wave_height,wave_period,wave_direction&timezone=Africa%2FAlgiers`);
        const d=await r.json(); const cu=d.current;
        if(!cu||cu.wave_height===null||cu.wave_height===undefined){document.getElementById('sea-state').textContent='--';document.getElementById('sea-desc').textContent='البيانات غير متاحة';return;}
        const wh=cu.wave_height.toFixed(1);
        const dirDeg=cu.wave_direction;
        const dirs=['شمال','شمال شرقي','شرقي','جنوب شرقي','جنوبي','جنوب غربي','غربي','شمال غربي'];
        const dirLabel=dirDeg!=null?dirs[Math.round(dirDeg/45)%8]:'--';
        const v=parseFloat(wh);
        // هل نهار؟ نستخدم ساعة الجهاز مع offset الجزائر (UTC+1)
        const nowAlgiers=new Date(new Date().toLocaleString('en-US',{timeZone:'Africa/Algiers'}));
        const hour=nowAlgiers.getHours();
        const isDaytime=hour>=6&&hour<20;
        let st,si,sd;
        if(v<0.5){
            st='هادئ'; si='🌊';
            sd=isDaytime?'البحر هادئ — مناسب للسباحة':'البحر هادئ — مناسب للصيد';
        } else if(v<1.0){
            st='هادئ نسبياً'; si='🌅';
            sd=isDaytime?'هادئ نسبياً — مناسب للسباحة':'هادئ نسبياً — مناسب للصيد';
        } else if(v<1.5){
            st='معتدل'; si='🌊';
            sd=isDaytime?'البحر معتدل — حذر للسباحة':'البحر معتدل — حذر للصيادين';
        } else if(v<2.5){
            st='مضطرب'; si='⚠️';
            sd='البحر مضطرب — يُنصح بالحذر';
        } else {
            st='عاصف'; si='🔴';
            sd='البحر عاصف — يُمنع الخروج';
        }
        document.getElementById('sea-state').textContent=st;
        document.getElementById('sea-icon').textContent=si;
        document.getElementById('sea-desc').textContent=sd;
        document.getElementById('sea-wave').textContent=wh;
        document.getElementById('sea-water-temp').textContent='19';
        document.getElementById('sea-dir').textContent=dirLabel;
        // ✅ نص الهيدر حسب النهار/الليل
        document.getElementById('sea-time-label').textContent=isDaytime?'للسياح والسباحين':'للصيادين الليليين';
    } catch{document.getElementById('sea-state').textContent='--';document.getElementById('sea-desc').textContent='تعذر التحميل';}
}

// ── ✅ 2: NEWS — custom_label حر ──
const categoryMap={official:'announcements',activity:'activities',social:'community'};
const catStyles={
    official:{grad:'from-red-500 to-red-700',badge:'bg-red-100 text-red-700',icon:'lucide:megaphone'},
    activity:{grad:'from-emerald-500 to-emerald-700',badge:'bg-emerald-100 text-emerald-700',icon:'lucide:clipboard-list'},
    social:{grad:'from-purple-500 to-purple-700',badge:'bg-purple-100 text-purple-700',icon:'lucide:heart-handshake'}
};

async function loadNews(){
    const loading=document.getElementById('news-loading');
    try{
        const r=await fetch('/api/news');
        const d=await r.json();
        loading.classList.add('hidden');
        if(!d.success||!d.data||d.data.length===0){
            ['announcements','activities','community'].forEach(t=>{document.getElementById('content-'+t).innerHTML='<p class="text-gray-400 text-sm text-center py-8 col-span-full">لا توجد أخبار حالياً</p>';});
            document.getElementById('content-announcements').classList.remove('hidden');return;
        }
        const grouped={announcements:[],activities:[],community:[]};
        d.data.forEach(n=>{const t=categoryMap[n.category]||'announcements';grouped[t].push(n);});
        Object.entries(grouped).forEach(([tab,items])=>{
            const c=document.getElementById('content-'+tab);
            if(items.length===0){c.innerHTML='<p class="text-gray-400 text-sm text-center py-8 col-span-full">لا توجد أخبار في هذا القسم</p>';return;}
            c.innerHTML=items.map(n=>{
                const s=catStyles[n.category]||catStyles.official;
                const img=n.image_url||'';
                const isPinned=n.is_pinned==1;
                const pinBadge=isPinned?'<div class="pin-badge"><span class="iconify text-sm" data-icon="lucide:pin"></span></div>':'';
                const pinLabel=isPinned?'<span class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-600 text-[10px] font-bold px-2 py-0.5 rounded-full border border-emerald-200"><span class="iconify" data-icon="lucide:pin"></span>مثبت</span>':'';
                const pinBorder=isPinned?'border-emerald-300 ring-1 ring-emerald-200':'border-gray-100';
                // ✅ 2: custom_label حر — يظهر فقط إذا كُتب
                const labelHtml=n.custom_label&&n.custom_label.trim()
                    ?`<span class="inline-block ${s.badge} text-xs font-bold px-3 py-1 rounded-full">${n.custom_label}</span>`
                    :'';
                return `<article class="bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-shadow border ${pinBorder} relative">
                    ${img?`<div class="h-48 overflow-hidden relative">${pinBadge}<img src="${img}" alt="${n.title}" class="w-full h-full object-cover"></div>`:`<div class="h-48 bg-gradient-to-bl ${s.grad} flex items-center justify-center relative">${pinBadge}<span class="iconify text-white text-6xl" data-icon="${s.icon}"></span></div>`}
                    <div class="p-5">
                        <div class="flex items-center gap-2 mb-3 flex-wrap">${labelHtml}${pinLabel}</div>
                        <h4 class="font-bold text-gray-800 mb-2 leading-snug">${n.title}</h4>
                        <p class="text-sm text-gray-500 mb-4 leading-relaxed">${(n.content||'').substring(0,120)}...</p>
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-gray-400 flex items-center gap-1"><span class="iconify" data-icon="lucide:calendar"></span>${n.date}</span>
                            <a href="/news/${n.id}" class="text-emerald-600 text-sm font-bold hover:text-emerald-700">اقرأ المزيد ←</a>
                        </div>
                    </div>
                </article>`;
            }).join('');
        });
        const fa=grouped.announcements.length>0?'announcements':grouped.activities.length>0?'activities':'community';
        document.getElementById('content-'+fa).classList.remove('hidden');
        document.querySelectorAll('.news-tab').forEach(t=>t.classList.remove('active'));
        document.getElementById('tab-'+fa).classList.add('active');
    } catch{
        loading.classList.add('hidden');
        ['announcements','activities','community'].forEach(t=>{document.getElementById('content-'+t).innerHTML='<p class="text-red-400 text-sm text-center py-8 col-span-full">تعذر تحميل الأخبار</p>';});
        document.getElementById('content-announcements').classList.remove('hidden');
    }
}

// ── TOURISM ──
async function loadTourism(){
    try{
        const res=await fetch('/api/tourism');
        const d=await res.json();
        const grid=document.getElementById('tourism-grid');
        if(!d.success||!d.data?.length){grid.innerHTML='<p class="col-span-2 text-gray-400 text-center py-8">لا توجد معالم سياحية بعد</p>';return;}
        const bcColors={emerald:'bg-emerald-500',amber:'bg-amber-500',purple:'bg-purple-500',teal:'bg-teal-500',blue:'bg-blue-500'};
        grid.innerHTML=d.data.map(t=>`
            <div class="tourism-card bg-white rounded-2xl overflow-hidden shadow-lg border border-gray-100 hover:shadow-2xl transition-shadow">
                <div class="relative h-64 overflow-hidden">
                    ${t.image_url?`<img src="${t.image_url}" alt="${t.name}" class="w-full h-full object-cover">`:`<div class="w-full h-full bg-gradient-to-bl from-emerald-400 to-emerald-700 flex items-center justify-center"><span class="iconify text-white text-8xl" data-icon="lucide:compass"></span></div>`}
                    <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                    <div class="absolute bottom-4 right-5 text-white"><h4 class="text-2xl font-extrabold">${t.name}</h4><p class="text-sm text-white/80">${t.subtitle||''}</p></div>
                    ${t.badge_text?`<span class="absolute top-4 left-4 ${bcColors[t.badge_color]||'bg-emerald-500'} text-white text-xs font-bold px-3 py-1 rounded-full">${t.badge_text}</span>`:''}
                </div>
                <div class="p-6"><p class="text-sm text-gray-600 leading-relaxed mb-4">${(t.description||'').substring(0,150)}...</p><div class="flex items-center gap-4 text-xs text-gray-500">${t.distance_info?`<span class="flex items-center gap-1"><span class="iconify text-emerald-500" data-icon="lucide:car"></span>${t.distance_info}</span>`:''}<span class="flex items-center gap-1"><span class="iconify text-amber-500" data-icon="lucide:star"></span>${t.rating||''}/5</span></div></div>
            </div>`).join('');
    } catch{document.getElementById('tourism-grid').innerHTML='<p class="col-span-2 text-red-400 text-center py-8">تعذر تحميل المعالم</p>';}
}

fetchWeather(); fetchSeaState(); loadNews(); loadTourism();
setInterval(()=>{fetchWeather();fetchSeaState();},900000);
</script>
