// ═══════════════════════════════
// UPLOAD HELPERS
// ═══════════════════════════════
function triggerUpload(id){document.getElementById(id).click();}
function readBase64(file){return new Promise((res,rej)=>{const r=new FileReader();r.onload=e=>res(e.target.result.split(',')[1]);r.onerror=rej;r.readAsDataURL(file);});}

async function uploadFile(file, folder){
    if(file.size>25*1024*1024) throw new Error('حجم الملف يتجاوز 25 MB');
    const base64=await readBase64(file);
    const resp=await fetch('/api/media',{method:'POST',headers:authHeaders(),body:JSON.stringify({filename:file.name,folder,data:base64,mime:file.type})});
    const d=await resp.json();
    if(!d.success) throw new Error(d.error||'فشل الرفع');
    return d.data.cdn_url;
}

// صورة واحدة مميزة
// widgetId: معرف div.upload-widget
// hiddenId: معرف input[type=hidden] للرابط النهائي
// folder: مجلد GitHub
async function handleFeatured(input, widgetId, hiddenId, folder){
    const file=input.files[0]; if(!file) return; input.value='';
    const ph=document.getElementById(widgetId+'-placeholder');
    const pre=document.getElementById(widgetId+'-preview');
    const upl=document.getElementById(widgetId+'-uploading');
    const w=document.getElementById(widgetId+'-widget')||document.getElementById(widgetId.replace('-img','')+'-img-widget');
    const widget = document.getElementById(widgetId+'-widget');
    ph.classList.add('hidden'); pre.classList.add('hidden'); upl.classList.remove('hidden');
    if(widget) widget.classList.add('uploading');
    try {
        const url=await uploadFile(file,folder);
        document.getElementById(hiddenId).value=url;
        const imgEl=document.getElementById(widgetId+'-img');
        const nameEl=document.getElementById(widgetId+'-name');
        if(imgEl) imgEl.src=url;
        if(nameEl) nameEl.textContent=file.name;
        upl.classList.add('hidden'); pre.classList.remove('hidden');
        if(widget){widget.classList.remove('uploading');widget.classList.add('has-image');}
        adminToast('✅ تم رفع الصورة');
        loadRepoSize();
    } catch(e){
        upl.classList.add('hidden'); ph.classList.remove('hidden');
        if(widget) widget.classList.remove('uploading');
        adminToast('❌ '+e.message);
    }
}

function clearWidget(widgetId, hiddenId, manualId){
    const ph=document.getElementById(widgetId+'-placeholder');
    const pre=document.getElementById(widgetId+'-preview');
    const widget=document.getElementById(widgetId+'-widget');
    if(ph) ph.classList.remove('hidden');
    if(pre) pre.classList.add('hidden');
    if(widget){widget.classList.remove('has-image','uploading');}
    document.getElementById(hiddenId).value='';
    if(manualId) document.getElementById(manualId).value='';
}

// ألبوم صور متعددة
async function handleAlbum(input, section){
    const file=input.files[0]; if(!file) return; input.value='';
    const btn=document.getElementById(section+'-album-btn');
    const orig=btn.innerHTML;
    btn.innerHTML='<span class="iconify spin" data-icon="lucide:loader-2"></span> جاري الرفع...';
    btn.disabled=true;
    try {
        const url=await uploadFile(file,section);
        newsAlbumUrls.push(url);
        document.getElementById('news-album-urls').value=JSON.stringify(newsAlbumUrls);
        renderAlbum();
        adminToast('✅ تمت إضافة الصورة للألبوم');
        loadRepoSize();
    } catch(e){ adminToast('❌ '+e.message); }
    finally{ btn.innerHTML=orig; btn.disabled=false; }
}

function renderAlbum(){
    const grid=document.getElementById('news-album-grid');
    grid.innerHTML=newsAlbumUrls.map((u,i)=>`
        <div class="album-thumb">
            <img src="${u}" loading="lazy" onerror="this.src='https://placehold.co/100x64/f3f4f6/ccc?text=!'">
            <div class="rm" onclick="removeAlbum(${i})">✕</div>
        </div>`).join('');
}
function removeAlbum(i){ newsAlbumUrls.splice(i,1); document.getElementById('news-album-urls').value=JSON.stringify(newsAlbumUrls); renderAlbum(); }

